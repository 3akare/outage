    <!-- Delete my data -->
    <string name="delete_title">Delete my data?</string>
    <string name="delete_body">This removes everything Outage keeps on this phone: your setup, your area, your power log and your alarms. It also asks the server to delete what it holds for this install. You cannot undo this.</string>
    <string name="delete_confirm">Delete</string>
