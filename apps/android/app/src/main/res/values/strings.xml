    <!-- About and privacy -->
    <string name="about_what">Outage tells you when power goes and when it comes back, using phones on charge.</string>
    <string name="privacy_cell">Outage keeps only the area cell of your spot, never your exact location.</string>
    <string name="privacy_anonymous">There is no name, phone number or email. Each install has one anonymous ID.</string> <!-- privacy-guard:allow user-facing privacy notice that says no name, phone number or email is collected; not a data field (to confirm with the human) -->
    <string name="privacy_sensors">Outage does not use the microphone or the motion sensors.</string>
    <string name="privacy_delete">You can delete everything in Settings.</string>

