    <string name="delete_done_server_pending">Deleted on this phone. The server copy will be deleted when you are online.</string>
    <string name="delete_failed">Could not delete everything on this phone. Try again.</string>

    <!-- About and privacy -->
    <string name="about_what">Outage tells you when power goes and when it comes back, using phones on charge.</string>
    <string name="privacy_cell">Outage keeps only the area cell of your spot, never your exact location.</string>
    <string name="privacy_anonymous">There is no name, phone number or email. Each install has one anonymous ID.</string> <!-- privacy-guard:allow user-facing privacy notice that says no name, phone number or email is collected; not a data field (to confirm with the human) -->
    <string name="privacy_sensors">Outage does not use the microphone or the motion sensors.</string>
    <string name="privacy_delete">You can delete everything in Settings.</string>

    <!-- Onboarding placeholder (debug builds only) -->
    <string name="first_run_title">Your charger is a power sensor</string>
    <string name="first_run_body">Outage notices when your phone stops charging because the power went out. It then tells you when the lights are back, even at night.</string>
    <string name="first_run_privacy">It never stores where you are, only a map cell about the size of a neighbourhood. You can delete everything in Settings.</string>
    <string name="first_run_ok">OK, start</string>
