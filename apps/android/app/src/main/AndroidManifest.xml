<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal permission, granted at install with no prompt. Home reads it to say "Offline" (app-shell R2.3).
         The shell requests no runtime permission (R9.2); features ask for theirs. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Normal permission, no prompt. One GET to the project's own Worker for the Area map (ADR 0025). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime permission from API 33. https://developer.android.com/develop/ui/views/notifications/notification-permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sensor (sensor-android, station-mode, ADR 0032). Normal permissions, no prompt. The persisted backup job and the
         restart after reboot need RECEIVE_BOOT_COMPLETED; the receiver service is a specialUse foreground service.
         https://developer.android.com/develop/background-work/services/fgs/service-types#special-use
         No microphone, motion sensor or location permission, ever (privacy.md, R12). -->
    <!-- Normal permission. Lets the battery setup screen show the one-tap exemption prompt. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Light Alarm (alerts-and-light-alarm). Normal permissions, no prompt. WAKE_LOCK keeps the CPU on for the ring (at most
         120 s); VIBRATE shakes the phone; USE_FULL_SCREEN_INTENT lets the alarm open over the lock screen where the system
         allows it (Android 14 limits it, so the app checks canUseFullScreenIntent first).
         https://developer.android.com/reference/android/Manifest.permission#USE_FULL_SCREEN_INTENT -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Onboarding spot (R3.2): coarse only, asked once in context when the user taps "Use my location once". Never fine location. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Freezer Guard (power-log R6): optional exact alarm. The user grants it in "Alarms & reminders" and can revoke it;
         the app checks canScheduleExactAlarms() before each use and falls back to an inexact alarm.
         https://developer.android.com/develop/background-work/services/alarms/schedule#exact-permission-declare -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".OutageApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Outage">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".sensor.ChargingJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".sensor.SensorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Power-cut sensor: listens for the charger being plugged in or out so the app can tell the user when grid power goes off and comes back." />
        </service>

        <!-- Explicit and not exported: only this app's own notification actions reach it (Android 14 rule). -->
        <receiver
            android:name=".alarm.NotificationActionReceiver"
            android:exported="false" />

        <!-- Token refresh for follow pushes (ADR 0036). https://firebase.google.com/docs/cloud-messaging/android/client -->
        <service
            android:name=".net.OutageMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".sensor.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Share card picture (power-log R8). Not exported; each share grants read access to one file.
             https://developer.android.com/training/secure-file-sharing/setup-sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <receiver
            android:name=".freezer.FreezerReceiver"
            android:exported="false" />
    </application>

</manifest>
