{
  // Ingest Worker (event-ingest). Area actors per H3 res-7 parent (ADR 0006), SQLite-backed (free plan only allows these):
  // https://developers.cloudflare.com/durable-objects/best-practices/access-durable-objects-storage/
  "name": "outage-api",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  // Public, non-secret values (ADR 0024). APK_URL is the releases page until the release workflow fills in a direct APK link
  // with APK_VERSION, APK_SIZE_BYTES and APK_SHA256 (release-apk skill).
  "vars": {
    "SITE_ORIGIN": "https://outage-api.bakaredavid007.workers.dev",
    "APK_URL": "https://github.com/3akare/outage/releases/latest"
  },
  "durable_objects": {
    "bindings": [
      { "name": "AREA", "class_name": "AreaActor" },
      { "name": "REGISTRY", "class_name": "RegistryActor" },
      { "name": "PUBLIC_INDEX", "class_name": "PublicIndex" },
      { "name": "TELEMETRY", "class_name": "TelemetryActor" },
      { "name": "PAIRING", "class_name": "PairingActor" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AreaActor"] },
    { "tag": "v2", "new_sqlite_classes": ["RegistryActor"] },
    { "tag": "v3", "new_sqlite_classes": ["PublicIndex"] },
    { "tag": "v4", "new_sqlite_classes": ["TelemetryActor"] },
    { "tag": "v5", "new_sqlite_classes": ["PairingActor"] }
  ]
  // Secret set by the human, never in this file: wrangler secret put INSTALL_TOKEN_SECRET
  // and for the field report: wrangler secret put FIELD_READ_TOKEN
}
